    {
      "parameters": {
        "jsCode": "// Get the first item from HTTP Request node\nconst httpData = $('HTTP Request1').first().json;\nconst aggregatedText = $json.text;\n\n// Join the aggregated text array into a single string\nlet transcriptText = '';\nif (Array.isArray(aggregatedText)) {\n  transcriptText = aggregatedText.join(' ');\n} else {\n  transcriptText = aggregatedText || '';\n}\n\n// Return formatted data for data table\nreturn {\n  URL: httpData.url || '',\n  ChannelName: httpData.channel_name || '',\n  VideoTitle: httpData.title || '',\n  videoPostDate: httpData.published_at || '',\n  transcript: transcriptText\n};"
